      <aliases enabled='yes' />
      <column caption='Average Order Value' datatype='real' name='[Average_Order_Value]' role='measure' type='quantitative' />
      <column caption='Zero' datatype='integer' name='[Calculation_0208361805955073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0208361819906050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] = &apos;Prefer Not to Say&apos; THEN &apos;Prefer Not to Say&apos;&#13;&#10;&#13;&#10;ELSEIF [Age] &lt;= &apos;17&apos; THEN &apos;Teen&apos;&#13;&#10;&#13;&#10;ELSEIF [Age] &lt;= &apos;25&apos; THEN &apos;Young Adult&apos;&#13;&#10;&#13;&#10;ELSEIF [Age] &lt;= &apos;35&apos; THEN &apos;Adult&apos;&#13;&#10;&#13;&#10;ELSEIF [Age] &lt;= &apos;50&apos; THEN &apos;Middle Age&apos;&#13;&#10;&#13;&#10;ELSEIF [Age] &lt;= &apos;65&apos; THEN &apos;Senior Adult&apos;&#13;&#10;&#13;&#10;ELSE &apos;Elderly&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Membership Group' datatype='string' name='[Calculation_0208362142441476]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Membership_Years] &lt;= 1 THEN &quot;0–1 Year&quot;&#13;&#10;ELSEIF [Membership_Years] &lt;= 2 THEN &quot;1–2 Years&quot;&#13;&#10;ELSEIF [Membership_Years] &lt;= 3 THEN &quot;2–3 Years&quot;&#13;&#10;ELSEIF [Membership_Years] &lt;= 5 THEN &quot;3–5 Years&quot;&#13;&#10;ELSE &quot;5+ Years&quot;&#13;&#10;END' />
      </column>
      <column caption='Icon Position' datatype='integer' name='[Calculation_0208362163810309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Churned]) + 100' />
      </column>
      <column caption='Session Group' datatype='string' name='[Calculation_0622053932716034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Session_Duration_Avg] &lt;= 5 THEN &apos;Very Short&apos;&#13;&#10;ELSEIF [Session_Duration_Avg] &lt;= 10 THEN &apos;Short&apos;&#13;&#10;ELSEIF [Session_Duration_Avg] &lt;= 20 THEN &apos;Medium&apos;&#13;&#10;ELSEIF [Session_Duration_Avg] &lt;= 40 THEN &apos;Long&apos;&#13;&#10;ELSE &apos;Very Long&apos;&#13;&#10;END' />
      </column>
      <column caption='Mobile Usage Group' datatype='string' name='[Calculation_0622054120796164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Mobile_App_Usage] = 0 THEN &quot;No Mobile Usage&quot;&#13;&#10;ELSEIF [Mobile_App_Usage] &lt;= 10 THEN &quot;Very Low Usage&quot;&#13;&#10;ELSEIF [Mobile_App_Usage] &lt;= 20 THEN &quot;Low Usage&quot;&#13;&#10;ELSEIF [Mobile_App_Usage] &lt;= 30 THEN &quot;Medium Usage&quot;&#13;&#10;ELSEIF [Mobile_App_Usage] &lt;= 40 THEN &quot;High Usage&quot;&#13;&#10;ELSE &quot;Very High Usage&quot;&#13;&#10;END' />
      </column>
      <column caption='Purchase Recency Group' datatype='string' name='[Calculation_1104741013512192]' role='dimension' type='nominal'>
