              <calculation class='tableau' formula='IF [Days_Since_Last_Purchase] &lt;= 7 THEN &quot;Very Active (0-7)&quot;&#13;&#10;ELSEIF [Days_Since_Last_Purchase] &lt;= 30 THEN &quot;Active (8-30)&quot;&#13;&#10;ELSEIF [Days_Since_Last_Purchase] &lt;= 60 THEN &quot;Warming Risk (31-60)&quot;&#13;&#10;ELSEIF [Days_Since_Last_Purchase] &lt;= 90 THEN &quot;At Risk (61-90)&quot;&#13;&#10;ELSEIF [Days_Since_Last_Purchase] &lt;= 120 THEN &quot;High Risk (91-120)&quot;&#13;&#10;ELSE &quot;Critical (&gt;120)&quot;&#13;&#10;END' />
