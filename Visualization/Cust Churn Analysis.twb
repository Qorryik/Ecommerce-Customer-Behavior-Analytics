        <view>
          <datasources>
            <datasource caption='clean_cust_curn' name='federated.1djd7pc035h5ig15j3ml50rbsm74' />
          </datasources>
          <datasource-dependencies datasource='federated.1djd7pc035h5ig15j3ml50rbsm74'>
            <column caption='Total Purchase Group' datatype='string' name='[Calculation_1315023274704907]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Total_Purchases] &lt; 2 THEN &quot;1 (One-time)&quot;&#13;&#10;ELSEIF [Total_Purchases] &lt; 5 THEN &quot;2–5 (Low)&quot;&#13;&#10;ELSEIF [Total_Purchases] &lt; 10 THEN &quot;5–10 (Medium)&quot;&#13;&#10;ELSEIF [Total_Purchases] &lt; 20 THEN &quot;10–20 (High)&quot;&#13;&#10;ELSEIF [Total_Purchases] &lt; 50 THEN &quot;20–50 (Very High)&quot;&#13;&#10;ELSE &quot;50+ (VIP)&quot;&#13;&#10;END' />
