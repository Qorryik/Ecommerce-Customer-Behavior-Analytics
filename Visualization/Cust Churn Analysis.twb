            <column caption='AOV Group' datatype='string' name='[Calculation_1315023071576071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Average_Order_Value] &lt; 50 THEN &quot;0–50&quot;&#13;&#10;ELSEIF [Average_Order_Value] &lt; 100 THEN &quot;50–100&quot;&#13;&#10;ELSEIF [Average_Order_Value] &lt; 150 THEN &quot;100–150&quot;&#13;&#10;ELSEIF [Average_Order_Value] &lt; 200 THEN &quot;150–200&quot;&#13;&#10;ELSE &quot;200+&quot;&#13;&#10;END' />
